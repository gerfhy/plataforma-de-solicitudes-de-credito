@model creditos.Models.SolicitudCredito
@{
    ViewData["Title"] = $"Detalle de Solicitud #{Model.Id}";
    var ingresos = Model.Cliente?.IngresosMensuales ?? 0m;
    var maxAprobacion = ingresos * 5;
    var maxRegistro = ingresos * 10;
    var ratioIngresos = ingresos > 0 ? (Model.MontoSolicitado / ingresos) : 0;
    var cumplePoliticaAprobacion = Model.MontoSolicitado <= maxAprobacion;
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-10">
        <!-- Tarjeta Principal de Detalle -->
        <div class="dashboard-card">
            <div class="card-header-sleek">
                <div class="d-flex align-items-center gap-3">
                    <a asp-action="Index" class="card-action-btn" title="Volver al catálogo">
                        <i class="bi bi-arrow-left"></i>
                    </a>
                    <div>
                        <h2 class="card-title-sleek mb-0">Solicitud de Crédito #@Model.Id</h2>
                        <span class="text-secondary small">Registrada el @Model.FechaSolicitud.ToString("dd MMMM yyyy, HH:mm") UTC</span>
                    </div>
                </div>

                <div>
                    @switch (Model.Estado)
                    {
                        case creditos.Models.EstadoSolicitud.Aprobado:
                            <span class="status-pill aprobado fs-6 px-3 py-2">Aprobado</span>
                            break;
                        case creditos.Models.EstadoSolicitud.Rechazado:
                            <span class="status-pill rechazado fs-6 px-3 py-2">Rechazado</span>
                            break;
                        default:
                            <span class="status-pill pendiente fs-6 px-3 py-2">Pendiente</span>
                            break;
                    }
                </div>
            </div>

            <!-- Resumen Financiero Destacado -->
            <div class="p-4 my-3 rounded-4" style="background: linear-gradient(135deg, #121316 0%, #1e2229 100%); color: #ffffff;">
                <div class="row align-items-center g-3">
                    <div class="col-12 col-md-4">
                        <div class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.05em; color: #94a3b8 !important;">
                            Monto Solicitado
                        </div>
                        <div class="display-6 fw-extrabold text-white mt-1">
                            $@Model.MontoSolicitado.ToString("N2")
                        </div>
                    </div>
                    <div class="col-12 col-md-4 border-start-md border-secondary">
                        <div class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.05em; color: #94a3b8 !important;">
                            Ratio sobre Ingresos
                        </div>
                        <div class="fs-3 fw-bold mt-1" style="color: @(cumplePoliticaAprobacion ? "var(--brand-neon-green)" : "var(--brand-coral)");">
                            @ratioIngresos.ToString("N1")x ingresos
                        </div>
                    </div>
                    <div class="col-12 col-md-4 border-start-md border-secondary">
                        <div class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.05em; color: #94a3b8 !important;">
                            Criterio de Aprobación (<= 5x)
                        </div>
                        <div class="d-flex align-items-center gap-2 mt-1">
                            @if (cumplePoliticaAprobacion)
                            {
                                <i class="bi bi-check-circle-fill fs-4" style="color: var(--brand-neon-green);"></i>
                                <span class="fw-semibold small" style="color: var(--brand-neon-green);">Dentro del límite permitido</span>
                            }
                            else
                            {
                                <i class="bi bi-x-circle-fill text-danger fs-4"></i>
                                <span class="text-danger fw-semibold small">Supera la capacidad de pago</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Motivo de Rechazo (si aplica) -->
            @if (Model.Estado == creditos.Models.EstadoSolicitud.Rechazado && !string.IsNullOrEmpty(Model.MotivoRechazo))
            {
                <div class="alert-sleek alert-sleek-danger my-3">
                    <i class="bi bi-x-octagon-fill fs-4"></i>
                    <div>
                        <div class="fw-bold">Motivo de Rechazo por el Analista:</div>
                        <div>@Model.MotivoRechazo</div>
                    </div>
                </div>
            }

            <!-- Desglose en Columnas -->
            <div class="row g-4 mt-2">
                <!-- Columna 1: Información de la Solicitud -->
                <div class="col-12 col-md-6">
                    <div class="p-3 bg-white rounded-3 border h-100">
                        <h6 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                            <i class="bi bi-file-earmark-text text-primary"></i> Datos de la Solicitud
                        </h6>
                        <table class="table table-borderless table-sm mb-0">
                            <tbody>
                                <tr>
                                    <td class="text-secondary">Identificador:</td>
                                    <td class="fw-bold text-dark">#@Model.Id</td>
                                </tr>
                                <tr>
                                    <td class="text-secondary">Fecha y Hora UTC:</td>
                                    <td class="fw-bold text-dark">@Model.FechaSolicitud.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                </tr>
                                <tr>
                                    <td class="text-secondary">Estado Actual:</td>
                                    <td class="fw-bold text-dark">@Model.Estado</td>
                                </tr>
                                <tr>
                                    <td class="text-secondary">Tope de Registro (10x):</td>
                                    <td class="fw-bold text-dark">$@maxRegistro.ToString("N2")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Columna 2: Datos del Cliente Solicitante -->
                <div class="col-12 col-md-6">
                    <div class="p-3 bg-white rounded-3 border h-100">
                        <h6 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                            <i class="bi bi-person-badge text-success"></i> Perfil del Solicitante
                        </h6>
                        <table class="table table-borderless table-sm mb-0">
                            <tbody>
                                <tr>
                                    <td class="text-secondary">Cliente ID:</td>
                                    <td class="fw-bold text-dark">#@Model.ClienteId</td>
                                </tr>
                                <tr>
                                    <td class="text-secondary">Usuario Registrado:</td>
                                    <td class="fw-bold text-dark">@(Model.Cliente?.Usuario?.UserName ?? "N/A")</td>
                                </tr>
                                <tr>
                                    <td class="text-secondary">Ingresos Mensuales:</td>
                                    <td class="fw-bold text-success">$@ingresos.ToString("N2")</td>
                                </tr>
                                <tr>
                                    <td class="text-secondary">Capacidad Máx. Aprobación:</td>
                                    <td class="fw-bold text-dark">$@maxAprobacion.ToString("N2")</td>
                                </tr>
                                <tr>
                                    <td class="text-secondary">Estado del Cliente:</td>
                                    <td>
                                        @if (Model.Cliente?.Activo == true)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Inactivo</span>
                                        }
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Botones de Acción Inferiores -->
            <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                <a asp-action="Index" class="btn-sleek-outline">
                    <i class="bi bi-arrow-left me-1"></i> Volver a Mis Solicitudes
                </a>

                @if (User.IsInRole("Analista") && Model.Estado == creditos.Models.EstadoSolicitud.Pendiente)
                {
                    <a asp-controller="Analista" asp-action="Index" class="btn-sleek-dark">
                        <i class="bi bi-shield-check me-1"></i> Ir al Panel de Evaluación
                    </a>
                }
            </div>
        </div>
    </div>
</div>
