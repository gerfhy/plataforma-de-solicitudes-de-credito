@model creditos.Models.CrearSolicitudViewModel
@{
    ViewData["Title"] = "Nueva Solicitud de Crédito";
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-9">
        <!-- Tarjeta del Formulario -->
        <div class="dashboard-card">
            <div class="card-header-sleek">
                <div class="d-flex align-items-center gap-3">
                    <a asp-action="Index" class="card-action-btn" title="Volver al catálogo">
                        <i class="bi bi-arrow-left"></i>
                    </a>
                    <div>
                        <h2 class="card-title-sleek mb-0">Registrar Solicitud de Crédito</h2>
                        <span class="text-secondary small">Ingresa el monto que deseas solicitar bajo las políticas vigentes</span>
                    </div>
                </div>

                <div>
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                        <i class="bi bi-shield-check text-success me-1"></i> Evaluación Automática
                    </span>
                </div>
            </div>

            <!-- Feedback de Éxito en la Misma Vista -->
            @if (Model.RegistroExitoso && Model.SolicitudCreadaId.HasValue)
            {
                <div class="p-4 my-3 rounded-4" style="background: linear-gradient(135deg, #052e16 0%, #064e3b 100%); color: #ffffff; box-shadow: 0 10px 25px rgba(5, 46, 22, 0.2);">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div style="width: 50px; height: 50px; border-radius: 50%; background: #10b981; display: flex; align-items: center; justify-content: center; color: white;">
                                <i class="bi bi-check-lg fs-3"></i>
                            </div>
                            <div>
                                <h4 class="fw-bold mb-1 text-white">¡Solicitud #@Model.SolicitudCreadaId Registrada con Éxito!</h4>
                                <div class="text-white-50 small">
                                    Se creó la solicitud por <strong>$@Model.MontoCreado?.ToString("N2")</strong> en estado <span class="status-pill pendiente py-0 px-2">Pendiente</span>.
                                </div>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@Model.SolicitudCreadaId" class="btn-sleek-success">
                                <i class="bi bi-eye me-1"></i> Ver Detalle de Solicitud
                            </a>
                            <a asp-action="Index" class="btn-sleek-outline text-white border-white">
                                Ir a Mis Solicitudes
                            </a>
                        </div>
                    </div>
                </div>
            }

            <!-- Resumen de Capacidad del Cliente -->
            <div class="row g-3 my-2">
                <div class="col-12 col-md-4">
                    <div class="p-3 bg-white rounded-3 border">
                        <div class="text-secondary small fw-semibold text-uppercase">Ingresos Mensuales</div>
                        <div class="fs-4 fw-bold text-dark mt-1">$@Model.IngresosMensuales.ToString("N2")</div>
                        <div class="text-muted small mt-1">Registrados en tu perfil</div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="p-3 bg-white rounded-3 border">
                        <div class="text-secondary small fw-semibold text-uppercase">Capacidad Aprobación (5x)</div>
                        <div class="fs-4 fw-bold mt-1" style="color: var(--brand-green);">$@Model.CapacidadAprobacion5x.ToString("N2")</div>
                        <div class="text-muted small mt-1">Límite para visto bueno del analista</div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="p-3 bg-white rounded-3 border">
                        <div class="text-secondary small fw-semibold text-uppercase">Tope Máximo Permitido (10x)</div>
                        <div class="fs-4 fw-bold text-dark mt-1">$@Model.LimiteMaximo10x.ToString("N2")</div>
                        <div class="text-muted small mt-1">Límite absoluto de solicitud</div>
                    </div>
                </div>
            </div>

            <!-- Advertencia de Solicitud Pendiente Existente -->
            @if (Model.TieneSolicitudPendiente && !Model.RegistroExitoso)
            {
                <div class="alert-sleek alert-sleek-danger my-3">
                    <i class="bi bi-exclamation-triangle-fill fs-3 text-danger"></i>
                    <div class="flex-grow-1">
                        <div class="fw-bold">Ya tienes una solicitud pendiente activa</div>
                        <div class="small">
                            El sistema únicamente permite <strong>una solicitud en estado Pendiente</strong> por cliente. 
                            Debes esperar la resolución de tu solicitud <strong>#@Model.SolicitudPendienteExistenteId</strong>.
                        </div>
                    </div>
                    @if (Model.SolicitudPendienteExistenteId.HasValue)
                    {
                        <a asp-action="Details" asp-route-id="@Model.SolicitudPendienteExistenteId" class="btn-sleek-outline btn-sm">
                            Ver Solicitud Activa
                        </a>
                    }
                </div>
            }

            <!-- Formulario de Envío -->
            <form asp-action="Create" method="post" class="mt-4">
                <div asp-validation-summary="ModelOnly" class="alert-sleek alert-sleek-danger mb-3" role="alert"></div>

                <div class="mb-4">
                    <label asp-for="MontoSolicitado" class="form-label-sleek fs-6">
                        Monto a Solicitar ($) <span class="text-danger">*</span>
                    </label>
                    <div class="position-relative">
                        <span class="position-absolute top-50 translate-middle-y ps-3 text-secondary fs-5 fw-bold">$</span>
                        <input asp-for="MontoSolicitado" 
                               type="number" 
                               step="0.01" 
                               class="form-control-sleek ps-5 fs-4 fw-bold text-dark" 
                               placeholder="Ej. 10000.00" 
                               disabled="@(Model.TieneSolicitudPendiente || !Model.ClienteActivo ? "disabled" : null)" />
                    </div>
                    <span asp-validation-for="MontoSolicitado" class="text-danger small d-block mt-2"></span>
                    <div class="text-secondary small mt-2">
                        <i class="bi bi-info-circle me-1"></i> El monto no puede ser negativo ni superar <strong>$@Model.LimiteMaximo10x.ToString("N2")</strong> (10x ingresos).
                    </div>
                </div>

                <!-- Botones de Acción -->
                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a asp-action="Index" class="btn-sleek-outline">
                        <i class="bi bi-arrow-left me-1"></i> Cancelar
                    </a>

                    @if (Model.TieneSolicitudPendiente || !Model.ClienteActivo)
                    {
                        <button type="button" class="btn-sleek-dark opacity-50" disabled>
                            <i class="bi bi-lock-fill me-1"></i> Registro Bloqueado por Política
                        </button>
                    }
                    else
                    {
                        <button type="submit" class="btn-sleek-dark px-4 py-2">
                            <i class="bi bi-send-fill me-1"></i> Enviar Solicitud de Crédito
                        </button>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
