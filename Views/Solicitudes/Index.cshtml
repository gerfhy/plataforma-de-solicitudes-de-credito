@model creditos.Models.CatalogoSolicitudesViewModel
@{
    ViewData["Title"] = "Mis Solicitudes";
}

<div class="row g-4">
    <!-- Panel de Filtros -->
    <div class="col-12">
        <div class="dashboard-card mb-4">
            <div class="card-header-sleek">
                <div class="d-flex align-items-center gap-2">
                    <span class="card-action-btn"><i class="bi bi-funnel-fill text-dark"></i></span>
                    <h2 class="card-title-sleek">Filtros de Búsqueda</h2>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a asp-action="Create" class="btn-sleek-dark py-1 px-3" style="font-size: 0.85rem;">
                        <i class="bi bi-plus-lg me-1"></i> Nueva Solicitud
                    </a>
                </div>
            </div>

            <form asp-action="Index" method="get" class="mt-3">
                <div class="row g-3">
                    <div class="col-12 col-md-3">
                        <label asp-for="Estado" class="form-label-sleek">Estado de la Solicitud</label>
                        <select asp-for="Estado" asp-items="Html.GetEnumSelectList<creditos.Models.EstadoSolicitud>()" class="form-select-sleek">
                            <option value="">-- Todos los Estados --</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-2">
                        <label asp-for="MontoMin" class="form-label-sleek">Monto Mínimo ($)</label>
                        <input asp-for="MontoMin" type="number" step="0.01" class="form-control-sleek" placeholder="Ej. 1000" />
                        <span asp-validation-for="MontoMin" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="col-12 col-md-2">
                        <label asp-for="MontoMax" class="form-label-sleek">Monto Máximo ($)</label>
                        <input asp-for="MontoMax" type="number" step="0.01" class="form-control-sleek" placeholder="Ej. 25000" />
                        <span asp-validation-for="MontoMax" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="col-12 col-md-2">
                        <label asp-for="FechaInicio" class="form-label-sleek">Fecha Desde</label>
                        <input asp-for="FechaInicio" type="date" class="form-control-sleek" />
                        <span asp-validation-for="FechaInicio" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="col-12 col-md-2">
                        <label asp-for="FechaFin" class="form-label-sleek">Fecha Hasta</label>
                        <input asp-for="FechaFin" type="date" class="form-control-sleek" />
                        <span asp-validation-for="FechaFin" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="col-12 col-md-1 d-flex align-items-end gap-2">
                        <button type="submit" class="btn-sleek-dark w-100 justify-content-center" title="Aplicar filtros">
                            <i class="bi bi-search"></i>
                        </button>
                        <a asp-action="Index" class="btn-sleek-outline" title="Limpiar filtros">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Catálogo de Solicitudes -->
    <div class="col-12">
        <div class="dashboard-card">
            <div class="card-header-sleek">
                <div class="d-flex align-items-center gap-3">
                    <h2 class="card-title-sleek">Listado de Solicitudes Registradas</h2>
                    <span class="badge bg-light text-dark border px-2 py-1 rounded-pill" style="font-size: 0.8rem;">
                        @Model.Solicitudes.Count resultado(s)
                    </span>
                </div>
                <div class="d-flex gap-2">
                    <span class="card-action-btn"><i class="bi bi-three-dots-vertical"></i></span>
                </div>
            </div>

            @if (Model.Solicitudes.Any())
            {
                <div class="table-responsive mt-3">
                    <table class="table-sleek">
                        <thead>
                            <tr>
                                <th># Solicitud</th>
                                <th>Monto Solicitado</th>
                                <th>Fecha de Registro</th>
                                <th>Estado</th>
                                <th>Motivo / Observación</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Solicitudes)
                            {
                                <tr>
                                    <td class="fw-bold text-dark">
                                        #@item.Id
                                    </td>
                                    <td class="fw-extrabold text-dark fs-6">
                                        $@item.MontoSolicitado.ToString("N2")
                                    </td>
                                    <td class="text-secondary">
                                        <i class="bi bi-clock me-1"></i>@item.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td>
                                        @switch (item.Estado)
                                        {
                                            case creditos.Models.EstadoSolicitud.Aprobado:
                                                <span class="status-pill aprobado">Aprobado</span>
                                                break;
                                            case creditos.Models.EstadoSolicitud.Rechazado:
                                                <span class="status-pill rechazado">Rechazado</span>
                                                break;
                                            default:
                                                <span class="status-pill pendiente">Pendiente</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.MotivoRechazo))
                                        {
                                            <span class="text-danger small"><i class="bi bi-info-circle me-1"></i>@item.MotivoRechazo</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn-sleek-outline py-1 px-3" style="font-size: 0.82rem;">
                                            <i class="bi bi-eye me-1"></i> Ver Detalle
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div style="width: 60px; height: 60px; border-radius: 50%; background: #f1f5f9; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px;">
                        <i class="bi bi-folder2-open fs-3 text-muted"></i>
                    </div>
                    <h5 class="fw-bold text-dark">No se encontraron solicitudes</h5>
                    <p class="text-secondary small mb-3">No hay solicitudes que coincidan con los filtros aplicados o aún no has creado ninguna solicitud.</p>
                    <a asp-action="Create" class="btn-sleek-dark">
                        <i class="bi bi-plus-lg me-1"></i> Crear mi primera solicitud
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
