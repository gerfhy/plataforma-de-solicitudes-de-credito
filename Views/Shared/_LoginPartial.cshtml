@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <div class="d-flex align-items-center gap-2">
        <a class="user-avatar-btn" asp-area="Identity" asp-page="/Account/Manage/Index" title="@User.Identity?.Name">
            <i class="bi bi-person-fill"></i>
            <span class="avatar-online-dot"></span>
        </a>
        <form class="d-inline m-0 p-0" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
            <button type="submit" class="btn-sleek-outline py-1 px-3" style="font-size: 0.8rem;" title="Cerrar sesión">
                <i class="bi bi-box-arrow-right"></i>
            </button>
        </form>
    </div>
}
else
{
    <div class="d-flex align-items-center gap-2">
        <a class="btn-sleek-outline py-1 px-3" style="font-size: 0.85rem;" asp-area="Identity" asp-page="/Account/Login">
            <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
        </a>
        <a class="btn-sleek-dark py-1 px-3" style="font-size: 0.85rem;" asp-area="Identity" asp-page="/Account/Register">
            Registrarse
        </a>
    </div>
}
